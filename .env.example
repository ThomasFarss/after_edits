# Banco de dados — Supabase Postgres (projeto: cqbqixnsdulwryjyyhwn)
# Pegue os valores exatos em: Supabase Dashboard → Project Settings → Database → Connection string
# (aba "Transaction" para o pooler, aba "Session"/direct para a conexão direta)

# Runtime (pooler, porta 6543) — usado pela aplicação em requests normais
DATABASE_URL="postgresql://postgres.cqbqixnsdulwryjyyhwn:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations (conexão direta, porta 5432) — usado só por `prisma migrate`
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.cqbqixnsdulwryjyyhwn.supabase.co:5432/postgres"

# Auth.js
AUTH_SECRET="gere-com: npx auth secret"

# Usuário admin inicial (usado apenas pelo prisma/seed.ts)
ADMIN_USER="admin@example.com"
ADMIN_PASSWORD="troque-esta-senha"

# Email do pedido de acesso (tela de login → "Solicitar acesso")
# Sem RESEND_API_KEY, o pedido ainda é salvo e aparece em Admin →
# Solicitações, só não dispara o email.
# 1. Crie uma conta grátis em https://resend.com e gere uma API key
# 2. RESEND_API_KEY = essa API key (único passo obrigatório)
# 3. ACCESS_REQUEST_TO_EMAIL (opcional) = já manda pra
#    thomasgfariass@gmail.com por padrão; só preencha pra usar outro email
# 4. ACCESS_REQUEST_FROM_EMAIL (opcional) = remetente; sem domínio próprio
#    verificado na Resend, deixe em branco pra usar o padrão de testes
#    (onboarding@resend.dev)
RESEND_API_KEY=""
ACCESS_REQUEST_TO_EMAIL=""
ACCESS_REQUEST_FROM_EMAIL=""
